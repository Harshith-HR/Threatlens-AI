# Copy to .env and restart the app after changes. Never use NEXT_PUBLIC_ for keys.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
# Optional override when nmap is not on PATH:
# NMAP_PATH=C:\Program Files (x86)\Nmap\nmap.exe
# Restrict scanning to an exact comma-separated list of hostnames (optional).
SCAN_ALLOWED_HOSTS=
# Enable only for your private/local lab targets.
SCAN_ALLOW_PRIVATE=false
# Set a long random access token before exposing the app beyond localhost.
APP_ACCESS_TOKEN=
THREATLENS_DATA_DIR=.data

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=threatlens
